/* Same look as polybar: black, white text, one accent (wallust color2),
   2px accent border, bar font. Colors come from colors-rofi.rasi, which
   wallust regenerates with every wallpaper. */
@import "~/.config/rofi/colors-rofi.rasi"

* {
    font:             "Monaspace Xenon Slashed 10";
    bg:               #000000;
    bg-alt:           #1a1a1a;
    background-color: transparent;
    text-color:       @foreground;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
}

mainbox  { padding: 10px; spacing: 10px; }

inputbar {
    padding:          6px 8px;
    spacing:          8px;
    background-color: @bg-alt;
    children:         [ prompt, entry ];
}
prompt   { text-color: @accent; }
entry    { placeholder: "search"; placeholder-color: @muted; }

listview { lines: 8; fixed-height: false; scrollbar: false; spacing: 2px; }

element         { padding: 5px 8px; spacing: 8px; }
element-icon    { size: 1.1em; }
element-text    { text-color: inherit; vertical-align: 0.5; }
element normal.normal, element alternate.normal { text-color: @foreground; }
element selected.normal { background-color: @accent; text-color: @foreground; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element selected.urgent { background-color: @urgent; text-color: @bg; }

message  { padding: 6px 8px; background-color: @bg-alt; }
textbox  { text-color: @foreground; }
