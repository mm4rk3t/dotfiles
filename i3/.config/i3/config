exec_always --no-startup-id ~/.config/i3/scripts/set_wallpaper.sh
exec_always --no-startup-id picom --config ~/.config/picom.conf -b

set $mod Mod4

# Pull in the wallust-generated color variables
include ~/.config/i3/colors.conf

for_window [class="^.*"] border pixel 2
gaps inner 10
gaps outer 5
# room for the floating polybar: 15px gap + 27px bar + 15px gap (minus inner 10)
gaps top 47

for_window [class="flameshot"] floating enable
for_window [class="Alacritty" tiling_from="auto"] floating enable
for_window [class="Thunar"] floating enable, move position center
for_window [class="^IsoMateric"] floating enable, move position center

# Detect monitor
exec_always --no-startup-id ~/.config/i3/monitors.sh

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:monospace 8
#font pango:DejaVu Sans Mono 8

# Give systemd user services the X session, then start graphical-session.target
# (xdg-desktop-portal needs it; it carries dark mode to GTK4/Electron apps)
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME && systemctl --user start i3-session.target
# XSETTINGS daemon: lets running GTK3 apps switch theme live (theme-mode writes the conf)
exec --no-startup-id sh -c 'theme-mode apply; exec xsettingsd -c ~/.cache/xsettingsd.conf'
exec --no-startup-id dex-autostart --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/scripts/lock.sh
# USB/removable drives: tray icon to mount, unmount and eject
exec --no-startup-id udiskie --tray --notify
# Volume tray icon. Started here, not from autostart: at login it raced the tray
# (stalonetray) and audio devices and died silently. Wait for stalonetray (up to
# 10s), then give it a moment more
exec --no-startup-id sh -c 'for i in $(seq 20); do pgrep -x stalonetray >/dev/null && break; sleep 0.5; done; sleep 2; exec ~/.local/bin/volumeicon-themed'

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
# Light/dark mode
bindsym $mod+t exec --no-startup-id theme-mode toggle

bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%

floating_modifier $mod
# Default minimum is 75x50, which pads small floats like the one-row tray popup
floating_minimum_size 30 x 30

bindsym $mod+Return exec alacritty
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/scripts/lock.sh
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/random-wallpaper
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id "rofi -show drun -show-icons"

# bindcode $mod+40 exec "rofi -modi drun,run -show drun"
# bindcode $mod+40 exec --no-startup-id i3-dmenu-desktop

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Screenshots
bindsym Print exec --no-startup-id maim "/home/$USER/Pictures/sc/$(date).png"
bindsym $mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) "/home/$USER/Pictures/sc/$(date).png"
bindsym Shift+Print exec --no-startup-id maim --select "/home/$USER/Pictures/sc/$(date).png"

# Flameshot: select a region and annotate it (Windows-style Win+Shift+S)
bindsym $mod+Shift+s exec --no-startup-id flameshot gui

## Clipboard Screenshots
bindsym Ctrl+Print exec --no-startup-id maim | xclip -selection clipboard -t image/png
bindsym Ctrl+$mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) | xclip -selection clipboard -t image/png
bindsym Ctrl+Shift+Print exec --no-startup-id maim --select | xclip -selection clipboard -t image/png

# Workspace names. Keep them plain numbers so they sort right; polybar
# (module/xworkspaces icon-*) shows logos for 9 (Spotify) and 10 (Notion)
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Spotify always opens on the music workspace (class is set late, so assign won't work).
# Only move it: i3 reruns for_window whenever the title changes (every song), so a
# "workspace $ws10" here would yank you to the music workspace on each track
for_window [class="Spotify"] move to workspace number $ws9
# Notion gets its own workspace too (move only, same reason as Spotify)
for_window [class="notion-electron"] move to workspace number $ws10
# Slack sets its class before mapping, so assign works (it acts once, when the
# window opens, so windows moved elsewhere later stay put)
assign [class="(?i)^slack$"] number $ws1

# Polybar calendar popup: float it where the mouse is (the date in the bar)
for_window [title="^polybar-calendar$"] floating enable, move position mouse, sticky enable

# Tray popup (toggled by the arrow in polybar): stalonetray inside trayframe.py,
# which draws its own subtle 1px border (i3's would turn accent on hover); picom
# adds the shadow. Floating, starts hidden. stalonetray is only managed for a
# moment before the frame takes it. Not into the scratchpad: taking it from
# there sends i3 no unmap, so i3 would keep managing it, focus it on every icon
# click and open the window that click starts (Blueman, 1Password) in the
# scratchpad, where i3 ignores the app's requests to show it
for_window [class="^trayframe$"] floating enable, border none, move scratchpad
for_window [class="^stalonetray$"] floating enable, border none
no_focus [class="^stalonetray$"]

# Settings popups from the bar/tray (wifi, bluetooth, volume) float centered
for_window [class="(?i)^nm-connection-editor$"] floating enable, resize set 720 480, move position center
for_window [class="(?i)^nm-applet$"] floating enable, move position center
for_window [class="(?i)^blueman-"] floating enable, resize set 720 480, move position center
for_window [class="(?i)pavucontrol"] floating enable, resize set 720 480, move position center
# 1Password: main window and Quick Access (X11 class com.onepassword.OnePassword)
for_window [class="(?i)onepassword|1password"] floating enable, move position center
for_window [class="(?i)onepassword|1password" title="^(?!Quick Access)"] resize set 1000 720, move position center

# Steam: the main window tiles; friends list, chats and small dialogs float.
# Float only, no move: i3 reruns for_window on title changes (chat titles change)
for_window [class="^steam$" title="^Friends List$"] floating enable, resize set 360 700
for_window [class="^steam$" title=" - Chat$|^Steam Settings$|^Steam - News|^Steam Guard|^Screenshot Uploader"] floating enable
